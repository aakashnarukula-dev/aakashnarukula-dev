# ---- Telephony -------------------------------------------------------------
# twilio  -> place real calls
# console -> simulate calls in the terminal (no account needed, great for testing)
CALL_PROVIDER=twilio

TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_FROM_NUMBER=+15551234567

# Public HTTPS URL that Twilio can reach (ngrok, cloudflared, or your server).
# Required for confirmation_mode: dtmf. Leave blank to run in polling mode.
PUBLIC_BASE_URL=https://your-tunnel.ngrok-free.app

# Verify that webhooks really came from Twilio. Keep this on in production.
VALIDATE_WEBHOOK_SIGNATURES=true
# Hang up on voicemail instead of talking to it.
MACHINE_DETECTION=true

# ---- Reply understanding ---------------------------------------------------
# Pick the provider in config.yaml (llm.provider), then set its key here.
# LLM_API_KEY overrides everything, so one variable works for any vendor.
LLM_API_KEY=

# Or use the vendor's conventional variable:
GEMINI_API_KEY=
# OPENAI_API_KEY=
# GROQ_API_KEY=
# XAI_API_KEY=
# DEEPSEEK_API_KEY=
# ANTHROPIC_API_KEY=

# Optional overrides (handy for trying a different model without editing YAML):
# LLM_PROVIDER=gemini
# LLM_MODEL=gemini-2.5-flash-lite
# LLM_BASE_URL=            # only needed for llm.provider: custom

# ---- Telegram --------------------------------------------------------------
# From @BotFather, and your own chat id from @userinfobot
TELEGRAM_BOT_TOKEN=123456789:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TELEGRAM_CHAT_ID=123456789

# ---- Recipient numbers referenced by config.yaml ---------------------------
MOM_PHONE=+919876543210
DAD_PHONE=+919876543211

# ---- App -------------------------------------------------------------------
CONFIG_PATH=config.yaml
DATABASE_PATH=data/reminders.db
HOST=0.0.0.0
PORT=8080
# Optional: require this in the X-Admin-Token header for /status and /admin/*
ADMIN_TOKEN=

# ---- console provider only -------------------------------------------------
# no_answer | busy | failed | answered_human | answered_machine
CONSOLE_OUTCOME=no_answer
CONSOLE_RING_SECONDS=3
